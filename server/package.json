{
  "name": "mallick-exchange-backend",
  "version": "1.0.0",
  "description": "Authoritative backend service for Mallick Exchange (NovaCEX)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/run_real_pg_migrations.ts",
    "test": "vitest run"
  },
  "keywords": [
    "crypto-exchange",
    "trading-engine",
    "double-entry-ledger"
  ],
  "author": "Mallick Exchange Team",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
