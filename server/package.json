{
  "name": "mallick-exchange-backend",
  "version": "1.0.0",
  "description": "Authoritative backend service for Mallick Exchange (NovaCEX)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --outdir=dist --packages=external",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/run_real_pg_migrations.ts",
    "test": "vitest run"
  },
  "keywords": [
    "crypto-exchange",
    "trading-engine",
    "double-entry-ledger"
  ],
  "author": "Mallick Exchange Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@msgpack/msgpack": "^3.1.3",
    "@nktkas/hyperliquid": "^0.33.3",
    "@sendgrid/mail": "^8.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "dotenv": "^17.4.2",
    "ecpair": "^3.0.2",
    "esbuild": "^0.25.0",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "tiny-secp256k1": "^2.2.4",
    "typescript": "^7.0.2",
    "viem": "^2.56.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
