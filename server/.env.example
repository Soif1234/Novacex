# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=mallick-exchange-backend
APP_VERSION=1.0.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://mallick:mallick_pass@localhost:5432/mallick_exchange
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mallick_exchange
DB_USER=mallick
DB_PASSWORD=mallick_pass
DB_POOL_MIN=2
DB_POOL_MAX=20
# Pool resilience & query timeout controls (milliseconds)
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=10000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Market Data (Binance)
EXTERNAL_MARKET_DATA_ENABLED=true
# Spot klines / ticker feed endpoint (geo-friendly Binance market-data mirror).
EXTERNAL_MARKET_DATA_URL=https://data-api.binance.vision/api/v3
# USDⓈ-M Futures kline endpoint (used by /market/klines for market=FUTURES).
# If fapi.binance.com is unreachable/geo-blocked from your deployment region, point
# this at an accessible Binance-compatible endpoint (e.g. a regional mirror/proxy).
EXTERNAL_MARKET_DATA_FUTURES_URL=https://fapi.binance.com/fapi/v1
EXTERNAL_MARKET_DATA_POLL_INTERVAL_MS=3000

# Logging & Shutdown
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# API Key Encryption (REQUIRED in production — server refuses to boot without it)
# Generate a strong random value, e.g.: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=

# Database TLS (managed Postgres). Mode: auto (TLS for remote, off for localhost) | require | disable
DB_SSL_MODE=auto
# Certificate validation. Keep true (secure). Set false ONLY if your provider needs it.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA bundle for full verification (use \n for newlines if single-line):
# DB_CA_CERT=

# Redis TLS (rediss:// URLs). Keep validation enabled unless the provider requires otherwise.
REDIS_SSL_REJECT_UNAUTHORIZED=true
# REDIS_CA_CERT=

# Run pending DB migrations automatically on startup (recommended for single-instance).
# Defaults to true in production. Set false to manage migrations via `npm run migrate`.
AUTO_MIGRATE=true

# Phase 9.2 Custody Abstraction Layer.
# MUST remain false until the real-money custody system is fully built and
# approved (Phase 9.12/9.13). When false, custody operations fail closed and
# no custody provider (mock or real) is wired to any financial state.
# No real provider credentials or endpoints belong here yet.
CUSTODY_ENABLED=false
