# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=mallick-exchange-backend
APP_VERSION=1.0.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://mallick:mallick_pass@localhost:5432/mallick_exchange
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mallick_exchange
DB_USER=mallick
DB_PASSWORD=mallick_pass
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging & Shutdown
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
