# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=mallick-exchange-backend
APP_VERSION=1.0.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Configuration
DATABASE_URL=postgresql://mallick:mallick_pass@localhost:5432/mallick_exchange
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mallick_exchange
DB_USER=mallick
DB_PASSWORD=mallick_pass
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging & Shutdown
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# API Key Encryption (REQUIRED in production — server refuses to boot without it)
# Generate a strong random value, e.g.: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=

# Database TLS (managed Postgres). Mode: auto (TLS for remote, off for localhost) | require | disable
DB_SSL_MODE=auto
# Certificate validation. Keep true (secure). Set false ONLY if your provider needs it.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA bundle for full verification (use \n for newlines if single-line):
# DB_CA_CERT=

# Redis TLS (rediss:// URLs). Keep validation enabled unless the provider requires otherwise.
REDIS_SSL_REJECT_UNAUTHORIZED=true
# REDIS_CA_CERT=

# Run pending DB migrations automatically on startup (recommended for single-instance).
# Defaults to true in production. Set false to manage migrations via `npm run migrate`.
AUTO_MIGRATE=true
